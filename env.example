# HuggingFace token (required for embedding model download)
HF_TOKEN=

# Shared API key — protects ollama, embedding, docling (set same value on all services)
BACKEND_API_KEY=sk-backend-change-me

# LM Studio (used with make lmstudio / make all-lmstudio)
LMS_PREFETCH=qwen/qwen3-8b      # downloaded on first boot (space-separated for multiple)
LMS_LOAD=qwen3-8b-instruct      # loaded into memory at startup; must match GET /v1/models identifier
# LM Studio auth uses BACKEND_API_KEY (same as all other providers)

# LiteLLM
LITELLM_MASTER_KEY=sk-local-dev        # change in production!
LITELLM_SALT_KEY=salt-change-me-32chr  # random 32+ char string, never change after first run

# Admin UI
UI_USERNAME=admin
UI_PASSWORD=changeme

# PostgreSQL
POSTGRES_USER=litellm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=litellm
